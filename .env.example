# Copy to .env and adjust as needed. docker-compose reads this file.

# Shared secret used to sign/verify JWTs. MUST be identical for user & course
# services. Generate a strong value for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-secret-change-me

# Postgres credentials (shared for local convenience; separate DBs per service)
POSTGRES_USER=smartcourse
POSTGRES_PASSWORD=smartcourse
